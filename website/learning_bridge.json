  "notation": [
    {
      "tutorial": "$H$",
      "project": "$S$, with $h_2$ for binary entropy",
      "meaning": "Information entropies are in bits; the project reserves $\\ln$ for natural logarithms in estimates."
    },
    {
      "tutorial": "$Q_1(\\mathcal N)$, Eq. (10.273)",
      "project": "$Q^{(1)}(\\mathcal N)$",
      "meaning": "The maximum of coherent information over all one-use input states. Preskill calls it “one-shot”; here it is not an operational finite-error one-shot capacity."
    },
    {
      "tutorial": "Input $A$, reference $R$",
      "project": "Input qubit (state $\\rho$), reference $\\mathsf R$",
      "meaning": "The reference purifies the chosen input and is not sent through the channel."
    },
    {
      "tutorial": "Receiver $B$, environment $E$",
      "project": "Receiver $\\mathsf B$; environment of a dilation",
      "meaning": "With a pure $RBE$ dilation, $H(RB)=H(E)$. A classical output flag does not give access to the environment."
    },
    {
      "tutorial": "$p$ in Eq. (10.310)",
      "project": "$p$ and $\\epsilon$ in M01",
      "meaning": "Preskill uses total Pauli-error probability, $p/3$ per error. Here $p$ selects destructive measurement and $\\epsilon$ flips its report. These are different channels."
    },
    {
      "tutorial": "$\\epsilon,\\delta$ in the capacity definition, p. 52",
      "project": "Physical reporting error $\\epsilon$",
      "meaning": "The tutorial symbols are accuracy/rate tolerances, not this fixed noise parameter."
    }
  ],
